name: security-scan

on:
  pull_request:
    branches: [ main, develop ]
  push:
    branches: [ main ]
  schedule:
    - cron: "0 6 * * 1"        # escaneo completo semanal (deuda existente)
  workflow_dispatch:

permissions:
  contents: read                # mínimo por defecto; se amplía por job

concurrency:
  group: security-scan-${{ github.ref }}
  cancel-in-progress: true

env:
  SEMGREP_VERSION: "X.Y.Z"      # TODO: fijar versión verificada en PyPI
  DC_VERSION: "12.2.0"          # TODO: confirmar versión vigente

jobs:
  sast:
    name: SAST - Semgrep
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@<SHA-COMPLETO>      # v4
        with:
          fetch-depth: 0                           # necesario para --baseline-commit
          persist-credentials: false

      - uses: actions/setup-python@<SHA-COMPLETO>  # v5
        with:
          python-version: "3.12"

      - name: Instalar Semgrep (versión fija)
        run: python -m pip install "semgrep==${SEMGREP_VERSION}"

      - name: Ejecutar Semgrep (reportes SARIF y JSON)
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: |
          mkdir -p reports
          EXTRA=""
          if [ -n "$BASE_SHA" ]; then EXTRA="--baseline-commit $BASE_SHA"; fi  # diff-aware solo en PR
          semgrep scan \
            --config p/owasp-top-ten --config p/secrets \
            --config p/java --config p/findsecbugs \
            --config semgrep-rules/ \
            --metrics=off \
            --sarif-output=reports/semgrep.sarif \
            --json-output=reports/semgrep.json \
            $EXTRA

      - name: Compuerta (falla ante hallazgos de severidad ERROR)
        run: |
          jq -e '[.results[] | select(.extra.severity=="ERROR")] | length == 0' reports/semgrep.json

      - name: Subir reportes como artefacto
        if: always()
        uses: actions/upload-artifact@<SHA-COMPLETO>  # v4
        with:
          name: semgrep-reports
          path: reports/

      - name: Subir SARIF a code scanning
        if: always()
        uses: github/codeql-action/upload-sarif@<SHA-COMPLETO>  # v3
        with:
          sarif_file: reports/semgrep.sarif
          category: semgrep

  sca:
    name: SCA - Dependency-Check
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@<SHA-COMPLETO>      # v4
        with:
          persist-credentials: false

      - uses: actions/setup-java@<SHA-COMPLETO>    # v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Restaurar caché de la base NVD
        uses: actions/cache/restore@<SHA-COMPLETO> # v4
        with:
          path: ~/.dependency-check/data
          key: dc-data-${{ runner.os }}-${{ github.run_id }}
          restore-keys: dc-data-${{ runner.os }}-

      - name: Instalar Dependency-Check (versión fija)
        run: |
          curl -sSL -o dc.zip "https://github.com/dependency-check/DependencyCheck/releases/download/v${DC_VERSION}/dependency-check-${DC_VERSION}-release.zip"
          unzip -q dc.zip

      - name: Ejecutar Dependency-Check
        env:
          NVD_API_KEY: ${{ secrets.NVD_API_KEY }}
        run: |
          mkdir -p reports
          ./dependency-check/bin/dependency-check.sh \
            --project "$GITHUB_REPOSITORY" \
            --scan . \
            --format SARIF --format JSON --format HTML \
            --out reports \
            --data "$HOME/.dependency-check/data" \
            --suppression security/dependency-check-suppressions.xml \
            --failOnCVSS 7 \
            --nvdApiKey "$NVD_API_KEY"

      - name: Guardar caché de la base NVD
        if: always()
        uses: actions/cache/save@<SHA-COMPLETO>    # v4
        with:
          path: ~/.dependency-check/data
          key: dc-data-${{ runner.os }}-${{ github.run_id }}

      - name: Subir reportes como artefacto
        if: always()
        uses: actions/upload-artifact@<SHA-COMPLETO>  # v4
        with:
          name: dependency-check-reports
          path: reports/

      - name: Subir SARIF a code scanning
        if: always()
        uses: github/codeql-action/upload-sarif@<SHA-COMPLETO>  # v3
        with:
          sarif_file: reports/dependency-check-report.sarif
          category: dependency-check